{
  "extends": "../../.config/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "noEmit": true,
    "isolatedModules": true,
    "types": ["node"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "verbatimModuleSyntax": true,
    "moduleDetection": "force"
  },
  "include": ["index.ts", "src/**/*.ts", "ws.d.ts"]
}
