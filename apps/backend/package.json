  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:vite": "vite build",
    "db:reset": "rm -rf data/",
    "db:seed": "tsx utils/seedTestData.ts",
    "dev": "tsx --tsconfig ./tsconfig.json --watch index.ts",
    "check-format": "pnpm -F ft_transcendence check-format",
    "fix-format": "pnpm -F ft_transcendence fix-format",
    "migrate": "tsx utils/migrate.ts",
    "migration:down": "tsx utils/rollback.ts",
    "seed:secret": "npx tsx utils/seedSecrets.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "ts-node": "ts-node",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:watch": "tsc -p tsconfig.json --noEmit --watch"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.2",
	"@elastic/ecs-pino-format": "^1.0.0",
    "fastify": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "nodemailer": "^7.0.6",
    "umzug": "^3.8.2",
    "ioredis": "^5.8.0",
    "fastify-metrics": "^12.1.0",
	"pino": "^10.0.0",
    "prom-client": "^15.1.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.1",
    "@types/umzug": "^2.3.9",
    "@types/uuid": "^10.0.0",
    "vite": "^7.1.5",
    "vite-tsconfig-paths": "^5.1.4"
  }
