{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.app.tsbuildinfo",

    /* App browser runtime */
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    /* Types for app runtime */
    "types": ["vite/client"],

    /* Ergonomics */
    "isolatedModules": true,

    /* Extra lint-y checks used only for the app build */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,

    /* Emit handled by Vite */
    "noEmit": true
  },
  "include": ["../src"],
  "exclude": ["../dist", "../node_modules"]
}
