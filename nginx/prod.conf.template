# /etc/nginx/templates/default.conf.template

resolver 127.0.0.11 ipv6=off valid=30s;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Extract JWT token from cookie
map $cookie_token $jwt_token {
  default $cookie_token;
  ''      close;
}

# Use JWT token for rate limiting in available, otherwise fallback to IP
map $jwt_token $rate_limit_key {
  'anonymous' $binary_remote_addr;
  default     $jwt_token;
}

##
# Rate limiting zones based on authentication token or IP
# These limit HTTP requests and initial WS connections.
# Once a WS connection is established between a client and a service,
# nginx limiting does not affect the messaging.

# General API rate limiting - 10 req per sec per user/IP (burst of 20)
limit_req_zone $rate_limit_key zone=api_limit:10m rate=10r/s;

# Authentication endpoints - 10 req per min per IP
# Based on IP since authenticating users don't yet have a token
# More lenient to allow multiple users behind same NAT/proxy
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=10r/m;

# File uploads - 5 req per min per user
limit_req_zone $rate_limit_key zone=upload_limit:10m rate=5r/m;

# Gameserver/matchmaking - limits reconnect storms
limit_req_zone $rate_limit_key zone=ws_connect_limit:10m rate=3r/s;

# Redirect HTTP to HTTPS
# uses templating so that we can use non-standard ports: redirect port 80
# to whatever is actually our HTTPS port
server {
  listen 80;
  server_name _;
   return 301 https://$host:${NGINX_HTTPS_PORT}$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  server_name _;

  client_max_body_size 20m;

  # Rate limit sends status 429
  limit_req_status 429;

  # SSL certificate configuration
  ssl_certificate /etc/nginx/certs/cert.pem;
  ssl_certificate_key /etc/nginx/certs/key.pem;

  # SSL configuration (modern security settings)
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers HIGH:!aNULL:!MD5;
  ssl_prefer_server_ciphers on;

  # Error page for rate limiting
  error_page 429 /429.html;
    location = /429.html {
      internal;
      default_type application/json;
      return 429 '{"message": "Too many requests. Please try again later."}';
    }

  #  ---------- API -> backend ----------
  location /api/ {
    limit_req zone=api_limit burst=20 nodelay;
    proxy_pass http://backend:${BACKEND_PORT};
    proxy_http_version 1.1;

    proxy_set_header Host               $http_host;
    proxy_set_header X-Forwarded-Proto  $scheme;
    proxy_set_header X-Forwarded-Host   $http_host;
    proxy_set_header X-Forwarded-Port   $server_port;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;

    proxy_set_header Upgrade            $http_upgrade;
    proxy_set_header Connection         $connection_upgrade;

    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  #  ---------- API -> backend auth endpoints ----------
  location ~ ^/api/(login|signup|auth|reset-password) {
    limit_req zone=auth_limit burst=10 nodelay;

    proxy_pass http://backend:${BACKEND_PORT};
    proxy_http_version 1.1;

    proxy_set_header Host               $http_host;
    proxy_set_header X-Forwarded-Proto  $scheme;
    proxy_set_header X-Forwarded-Host   $http_host;
    proxy_set_header X-Forwarded-Port   $server_port;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;

    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  # ---------- Static uploads via backend ----------
  location /uploads/ {
    limit_req zone=upload_limit burst=5 nodelay;
    proxy_pass http://backend:${BACKEND_PORT};
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
  }

  location /g/ {
    limit_req zone=ws_connect_limit burst=5 nodelay;

    proxy_pass http://game-gateway:${GATEWAY_PORT};
    proxy_http_version 1.1;

    proxy_set_header Host               $host;
    proxy_set_header X-Forwarded-Proto  $scheme;
    proxy_set_header X-Forwarded-Host   $http_host;
    proxy_set_header X-Forwarded-Port   $server_port;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;

    proxy_set_header Upgrade            $http_upgrade;
    proxy_set_header Connection         $connection_upgrade;

    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    proxy_buffering off;
  }

  location /matchmaking {
    limit_req zone=ws_connect_limit burst=5 nodelay;

    proxy_pass http://matchmaking-service:${MATCHMAKING_PORT};
    proxy_http_version 1.1;

    proxy_set_header Host               $http_host;
    proxy_set_header X-Forwarded-Proto  $scheme;
    proxy_set_header X-Forwarded-Host   $http_host;
    proxy_set_header X-Forwarded-Port   $server_port;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;

    proxy_set_header Upgrade            $http_upgrade;
    proxy_set_header Connection         $connection_upgrade;

    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    proxy_buffering off;
  }

  location /chat {
    limit_req zone=ws_connect_limit burst=5 nodelay;

    proxy_pass http://chat-service:${CHAT_PORT};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;

    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    proxy_buffering off;
  }

  # Redirect plain /kibana (no slash) to /kibana/
  location = /kibana {
    return 301 /kibana/;
  }

  location /kibana/ {
    # Use variable to force runtime DNS resolution (won't fail at startup if kibana doesn't exist)
    set $kibana_upstream http://kibana:${KIBANA_PORT};
    proxy_pass $kibana_upstream/;
    proxy_http_version 1.1;

    proxy_set_header Host               $http_host;
    proxy_set_header X-Forwarded-Proto  $scheme;
    proxy_set_header X-Forwarded-Host   $http_host;
    proxy_set_header X-Forwarded-Port   $server_port;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;

    proxy_set_header Upgrade            $http_upgrade;
    proxy_set_header Connection         $connection_upgrade;

    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  # Redirect plain /grafana (no slash) to /grafana/
  location = /grafana {
    return 301 /grafana/;
  }

  location /grafana/ {
    # Use variable to force runtime DNS resolution (won't fail at startup if grafana doesn't exist)
    set $grafana_upstream http://grafana:${GRAFANA_PORT};
    proxy_pass $grafana_upstream; # must NOT have trailing slash
    proxy_http_version 1.1;

    proxy_set_header Host               $host;
    proxy_set_header X-Real-IP          $remote_addr;
    proxy_set_header X-Forwarded-Proto  $scheme;
    proxy_set_header X-Forwarded-Host   $http_host;
    proxy_set_header X-Forwarded-Port   $server_port;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;

    proxy_set_header Upgrade            $http_upgrade;
    proxy_set_header Connection         $connection_upgrade;

    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    proxy_redirect off;
  }

  # ---------- Site served from volume populated by the frontend container ----
   location / {
    root /usr/share/nginx/html;
    index index.html;
    try_files $uri /index.html;
  }

}

# for metrics, only on docker network, used by nginx-prometheus-exporter
server {
  listen ${NGINX_STUB_STATUS_PORT};
  server_name _;

  access_log off;
  location /stub_status {
    stub_status;
    allow 172.16.0.0/12;  # internal Docker subnet
    deny all;
  }
}
