# /etc/nginx/templates/default.conf.template

resolver 127.0.0.11 ipv6=off valid=30s;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Redirect HTTP to HTTPS
# uses templating so that we can use non-standard ports: redirect port 80
# to whatever is actually our HTTPS port
server {
  listen 80;
  server_name _;
   return 301 https://$host:${NGINX_HTTPS_PORT}$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  server_name _;

  client_max_body_size 20m;

  # SSL certificate configuration
  ssl_certificate /etc/nginx/certs/cert.pem;
  ssl_certificate_key /etc/nginx/certs/key.pem;

  # SSL configuration (modern security settings)
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers HIGH:!aNULL:!MD5;
  ssl_prefer_server_ciphers on;

  #  ---------- API -> backend ----------
  location /api/ {
    proxy_pass http://backend:${BACKEND_PORT};
    proxy_http_version 1.1;

    proxy_set_header Host               $http_host;
    proxy_set_header X-Forwarded-Proto  $scheme;
    proxy_set_header X-Forwarded-Host   $http_host;
    proxy_set_header X-Forwarded-Port   $server_port;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;

    proxy_set_header Upgrade            $http_upgrade;
    proxy_set_header Connection         $connection_upgrade;

    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  # ---------- Static uploads via backend ----------
  location /uploads/ {
	proxy_pass http://backend:${BACKEND_PORT};
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
  }


  location /matchmaking {
    proxy_pass http://matchmaking-service:4242;
    proxy_http_version 1.1;

    proxy_set_header Host               $http_host;
    proxy_set_header X-Forwarded-Proto  $scheme;
    proxy_set_header X-Forwarded-Host   $http_host;
    proxy_set_header X-Forwarded-Port   $server_port;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;

    proxy_set_header Upgrade            $http_upgrade;
    proxy_set_header Connection         $connection_upgrade;

    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  location /game-server {
    proxy_pass http://game-server:55553;
    proxy_http_version 1.1;

    proxy_set_header Host               $http_host;
    proxy_set_header X-Forwarded-Proto  $scheme;
    proxy_set_header X-Forwarded-Host   $http_host;
    proxy_set_header X-Forwarded-Port   $server_port;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;

    proxy_set_header Upgrade            $http_upgrade;
    proxy_set_header Connection         $connection_upgrade;

    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}

  location /g/ {
    proxy_pass http://game-gateway:55550;
    proxy_http_version 1.1;

    proxy_set_header Host               $http_host;
    proxy_set_header X-Forwarded-Proto  $scheme;
    proxy_set_header X-Forwarded-Host   $http_host;
    proxy_set_header X-Forwarded-Port   $server_port;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;

    proxy_set_header Upgrade            $http_upgrade;
    proxy_set_header Connection         $connection_upgrade;

    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}

  # Redirect plain /kibana (no slash) to /kibana/
  location = /kibana {
    return 301 /kibana/;
  }

  location /kibana/ {
    proxy_pass http://kibana:${KIBANA_PORT}/;
    proxy_http_version 1.1;

    proxy_set_header Host               $http_host;
    proxy_set_header X-Forwarded-Proto  $scheme;
    proxy_set_header X-Forwarded-Host   $http_host;
    proxy_set_header X-Forwarded-Port   $server_port;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;

    proxy_set_header Upgrade            $http_upgrade;
    proxy_set_header Connection         $connection_upgrade;

    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}

# # Redirect plain /grafana (no slash) to /grafana/
  location = /grafana {
    return 301 /grafana/;
  }

  location /grafana/ {
    proxy_pass http://grafana:${GRAFANA_PORT}; # must NOT have trailing slash
    proxy_http_version 1.1;

    proxy_set_header Host               $host;
    proxy_set_header X-Real-IP          $remote_addr;
    proxy_set_header X-Forwarded-Proto  $scheme;
    proxy_set_header X-Forwarded-Host   $http_host;
    proxy_set_header X-Forwarded-Port   $server_port;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;

    proxy_set_header Upgrade            $http_upgrade;
    proxy_set_header Connection         $connection_upgrade;

    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    proxy_redirect off;
  }

  # ---------- Site served from volume populated by the frontend container ----
   location / {
    root /usr/share/nginx/html;
    index index.html;
    try_files $uri /index.html;
  }

}

# for metrics, only on docker network, used by nginx-prometheus-exporter
server {
  listen ${NGINX_STUB_STATUS_PORT};
  server_name _;

  access_log off;
  location /stub_status {
    stub_status;
    allow 172.16.0.0/12;  # internal Docker subnet
    deny all;
  }
}
