{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",

    /* Common resolution/defaults across the monorepo */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    /* Safety & lint-like checks */
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* Monorepo aliases */
    "baseUrl": ".",
    "paths": {
      "@pong/shared": ["packages/pong/shared/src/index.ts"],
      "@pong/shared/*": ["packages/pong/shared/src/*"],
      "@pong/game-logic": ["packages/pong/game-logic/src/index.ts"],
      "@pong/game-logic/*": ["packages/pong/game-logic/src/*"],
      "@pong/render": ["packages/pong/render/src/index.ts"],
      "@pong/render/*": ["packages/pong/render/src/*"]
    }
  }
}
