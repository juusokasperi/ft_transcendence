{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@pong/shared": ["packages/pong/shared/src/index.ts"],
      "@pong/shared/*": ["packages/pong/shared/src/*"],
      "@pong/game": ["packages/pong/game-logic/src/index.ts"],
      "@pong/game/*": ["packages/pong/game-logic/src/*"],
      "@pong/render": ["packages/pong/render-babylon/src/index.ts"],
      "@pong/render/*": ["packages/pong/render-babylon/src/*"]
    }
  }
}
