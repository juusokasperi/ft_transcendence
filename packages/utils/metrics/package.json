{
  "name": "@utils/metrics",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable Fastify metrics configuration with Prometheus support",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "lint": "pnpm -F ft_transcendence lint",
    "check-format": "pnpm -F ft_transcendence check-format",
    "fix-format": "pnpm -F ft_transcendence fix-format"
  },
  "dependencies": {
    "fastify-metrics": "^12.1.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "fastify": "^5.6.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "fastify": "^5.6.0"
  }
}
