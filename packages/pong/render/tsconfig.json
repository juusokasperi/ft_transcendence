{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "stripInternal": true,
    "noEmitOnError": true,

    "composite": true,
    "incremental": true,

    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "emitDeclarationOnly": true
  },
  "include": ["src"],
  "exclude": ["src/demo/**"],
  "references": [{ "path": "../shared" }, { "path": "../game-logic" }]
}
