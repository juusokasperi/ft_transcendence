{
  "name": "@pong/render",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=20.19.0" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui/tailwind.css": "./src/client/ui/tailwind.css",
    "./register": "./src/client/babylon-register.ts"
  },
  "files": ["dist", "src/client/ui/tailwind.css"],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "clean": "rimraf dist",
    "check-format": "pnpm -F ft_transcendence check-format",
    "fix-format": "pnpm -F ft_transcendence fix-format",
    "lint": "pnpm -F ft_transcendence lint"
  },
  "dependencies": {
    "@babylonjs/core": "^8.26.2",
    "@babylonjs/gui": "^8.26.2",
    "@babylonjs/loaders": "^8.26.2",
    "@babylonjs/materials": "^8.26.2",
    "@pong/game-logic": "workspace:*",
    "@pong/shared": "workspace:*"
  },
  "peerDependencies": {
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "vite": "^7.1.2"
  }
}
