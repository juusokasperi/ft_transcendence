{
  "name": "@pong/render",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "src/client/babylon-register.ts",
    "src/client/ui/tailwind.css"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./ui/tailwind.css": "./src/client/ui/tailwind.css",
    "./register": "./src/client/babylon-register.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "clean": "rimraf dist",
    "check-format": "pnpm -F ft_transcendence check-format",
    "fix-format": "pnpm -F ft_transcendence fix-format",
    "lint": "pnpm -F ft_transcendence lint"
  },
  "dependencies": {
    "@babylonjs/core": "^8.27.0",
    "@babylonjs/gui": "^8.27.0",
    "@babylonjs/loaders": "^8.27.0",
    "@babylonjs/materials": "^8.27.0",
    "@pong/game-logic": "workspace:*",
    "@pong/shared": "workspace:*"
  },
  "peerDependencies": {
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "vite": "^7.1.5"
  }
}
