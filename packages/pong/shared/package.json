{
  "name": "@pong/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared domain types and pure utilities used by game and adapters.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./auth/tokenSign": {
      "types": "./src/auth/tokenSign.ts",
      "import": "./src/auth/tokenSign.ts"
    },
    "./protocol/net": {
      "types": "./src/protocol/net.ts",
      "import": "./src/protocol/net.ts"
    },
    "./protocol/events": {
      "types": "./src/protocol/events.ts",
      "import": "./src/protocol/events.ts"
    },
    "./protocol/input": {
      "types": "./src/protocol/input.ts",
      "import": "./src/protocol/input.ts"
    },
    "./protocol/state": {
      "types": "./src/protocol/state.ts",
      "import": "./src/protocol/state.ts"
    },
    "./utils/random": {
      "types": "./src/utils/random.ts",
      "import": "./src/utils/random.ts"
    },
    "./redis/constants": {
      "types": "./src/redis/constants.ts",
      "import": "./src/redis/constants.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "lint": "pnpm -F ft_transcendence lint",
    "check-format": "pnpm -F ft_transcendence check-format",
    "fix-format": "pnpm -F ft_transcendence fix-format"
  }
}
