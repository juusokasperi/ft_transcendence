{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "composite": true,
    "incremental": true,

    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "stripInternal": true,
    "noEmitOnError": true,

    "allowImportingTsExtensions": false
  },
  "include": ["src"]
}
