{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "stripInternal": true,
    "noEmitOnError": true,
    "composite": true,
    "incremental": true,
    "lib": ["ES2022"],
    "types": [],
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler"
  },
  "include": ["src"],
  "references": [{ "path": "../shared" }]
}
